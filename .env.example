# Copy this file to .env.local and fill in real values.
# Vercel-injected vars (VERCEL_*, KV_URL, TURBO_*, NX_DAEMON, ...) are not
# listed here — `vercel env pull` adds those automatically and they aren't
# something you set by hand.

# ── Database (Prisma, raw pg adapter — bypasses Supabase RLS) ──────────────
DATABASE_URL=

# ── Supabase (auth + storage) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App URL (used for metadata, emails, redirects) ──────────────────────────
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# ── Cron / trigger processing ───────────────────────────────────────────────
# Signs unlock tokens and authenticates the Vercel Cron job that calls
# /api/cron/process-triggers. Required in production — lib/unlock-token.ts
# throws on boot without it outside development.
CRON_SECRET=

# ── Rate limiting (Upstash Redis via Vercel Marketplace) ───────────────────
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── AI-assist (OpenRouter) ──────────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── Billing (Stripe) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_LIFETIME=

# ── Error monitoring (Sentry) ───────────────────────────────────────────────
# Only needed for uploading source maps during `npm run build`; the DSN
# itself is hardcoded in sentry.*.config.ts (public identifier, safe to ship).
SENTRY_AUTH_TOKEN=

# ── Blueprint encryption ────────────────────────────────────────────────────
# AES-256-GCM key (32 random bytes, base64) encrypting BlueprintItem.content
# at rest — this field often holds passwords/account access. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key permanently loses access to all encrypted content — back
# it up securely outside Vercel, not just in the dashboard.
BLUEPRINT_ENCRYPTION_KEY=

# ── Operator (marketing footer) ─────────────────────────────────────────────
# Legal operator shown in the landing page footer. Any field left empty is
# not rendered. The email is also the "Contact" link.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_OPERATOR_ID=
NEXT_PUBLIC_OPERATOR_EMAIL=
